# Copy to .env for local overrides. Never commit .env.

# Local default (no Docker needed): SQLite file in the project folder
AG_DATABASE_URL=sqlite:///./authorityguard.db

# With Docker Compose / PostgreSQL:
# AG_DATABASE_URL=postgresql+psycopg://authorityguard:authorityguard@localhost:5432/authorityguard

AG_ENV=dev

# Ed25519 signing key for capability tokens (PEM). Auto-generated in dev if missing.
# Never commit it. In Docker / hosted environments mount it as a secret.
AG_SIGNING_KEY_PATH=.keys/signing-ed25519.pem
